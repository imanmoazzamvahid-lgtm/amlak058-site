{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iran-llm.local/schemas/legal_document.schema.json",
  "title": "IRAN Legal Source Document",
  "type": "object",
  "required": [
    "document_id",
    "document_type",
    "title",
    "jurisdiction",
    "source",
    "dates",
    "text",
    "legal_status",
    "rights"
  ],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "document_type": {
      "type": "string",
      "enum": ["constitution", "statute", "bylaw", "circular", "unified_precedent", "judicial_opinion", "advisory_opinion", "other"]
    },
    "title": {"type": "string"},
    "jurisdiction": {"const": "IR"},
    "issuing_authority": {"type": ["string", "null"]},
    "dates": {
      "type": "object",
      "properties": {
        "adoption_jalali": {"type": ["string", "null"]},
        "approval_jalali": {"type": ["string", "null"]},
        "publication_jalali": {"type": ["string", "null"]},
        "effective_from_jalali": {"type": ["string", "null"]},
        "effective_until_jalali": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["url", "retrieved_at", "source_kind"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_kind": {"enum": ["official_gazette", "official_database", "court_publication", "other"]},
        "official_publication_number": {"type": ["string", "null"]},
        "official_publication_date": {"type": ["string", "null"]},
        "sha256": {"type": "string"}
      },
      "additionalProperties": false
    },
    "legal_status": {
      "type": "object",
      "required": ["status", "checked_at"],
      "properties": {
        "status": {"enum": ["in_force", "partially_amended", "repealed", "temporary", "unknown"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "status_source_url": {"type": ["string", "null"], "format": "uri"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "target_document_id"],
        "properties": {
          "relation": {"enum": ["amends", "repeals", "implements", "interprets", "supersedes", "related_to"]},
          "target_document_id": {"type": "string"},
          "affected_articles": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "text": {
      "type": "object",
      "required": ["full_text"],
      "properties": {
        "full_text": {"type": "string"},
        "articles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["article_number", "body"],
            "properties": {
              "article_number": {"type": "string"},
              "body": {"type": "string"},
              "paragraphs": {"type": "array", "items": {"type": "string"}},
              "amendment_note": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": ["license_or_basis", "training_approved", "reviewer"],
      "properties": {
        "license_or_basis": {"type": "string"},
        "training_approved": {"type": "boolean"},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "restrictions": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}